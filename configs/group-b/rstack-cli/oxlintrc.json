{
  "plugins": [
    "eslint",
    "typescript"
  ],
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "ignorePatterns": [
    "**/*.vue",
    "**/*.svelte",
    "**/*.astro",
    "/eslint.config.bench.mjs",
    "/rslint.config.bench.mjs"
  ],
  "rules": {
    "eslint/for-direction": "error",
    "eslint/no-async-promise-executor": "error",
    "eslint/no-case-declarations": "error",
    "eslint/no-compare-neg-zero": "error",
    "eslint/no-constant-binary-expression": "error",
    "eslint/no-constant-condition": "error",
    "eslint/no-control-regex": "error",
    "eslint/no-debugger": "error",
    "eslint/no-delete-var": "error",
    "eslint/no-dupe-else-if": "error",
    "eslint/no-duplicate-case": "error",
    "eslint/no-empty": "error",
    "eslint/no-empty-character-class": "error",
    "eslint/no-empty-pattern": "error",
    "eslint/no-empty-static-block": "error",
    "eslint/no-ex-assign": "error",
    "eslint/no-extra-boolean-cast": "error",
    "eslint/no-fallthrough": "error",
    "eslint/no-global-assign": "error",
    "eslint/no-irregular-whitespace": "error",
    "eslint/no-loss-of-precision": "error",
    "eslint/no-misleading-character-class": "error",
    "eslint/no-nonoctal-decimal-escape": "error",
    "eslint/no-prototype-builtins": "error",
    "eslint/no-regex-spaces": "error",
    "eslint/no-self-assign": "error",
    "eslint/no-shadow-restricted-names": "error",
    "eslint/no-sparse-arrays": "error",
    "eslint/no-unassigned-vars": "error",
    "eslint/no-unsafe-finally": "error",
    "eslint/no-unsafe-optional-chaining": "error",
    "eslint/no-unused-labels": "error",
    "eslint/no-useless-assignment": "error",
    "eslint/no-useless-backreference": "error",
    "eslint/no-useless-catch": "error",
    "eslint/no-useless-escape": "error",
    "eslint/preserve-caught-error": "error",
    "eslint/require-yield": "error",
    "eslint/use-isnan": "error",
    "eslint/valid-typeof": "error",
    "eslint/no-var": "error",
    "eslint/prefer-const": "error",
    "eslint/prefer-rest-params": "error",
    "eslint/prefer-spread": "error",
    "eslint/no-array-constructor": "error",
    "typescript/no-base-to-string": "error",
    "typescript/no-duplicate-enum-values": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-implied-eval": "error",
    "typescript/no-misused-new": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-namespace": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unsafe-declaration-merging": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-unary-minus": "error",
    "eslint/no-unused-vars": "error",
    "typescript/prefer-as-const": "error",
    "typescript/prefer-namespace-keyword": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/require-await": "error",
    "typescript/restrict-plus-operands": "error"
  },
  "overrides": [
    {
      "files": [
        "cspell.config.js",
        "rstack.config.ts",
        ".agents/**",
        "examples/app-react/rstack.config.ts",
        "examples/app-vanilla/rstack.config.ts",
        "examples/lib-node/rstack.config.ts",
        "examples/lib-node/tests/**",
        "examples/lib-react/rstack.config.ts",
        "packages/create-rstack/bin.js",
        "packages/create-rstack/rstack.config.ts",
        "packages/create-rstack/template-app-lit-ts/rstack.config.ts",
        "packages/create-rstack/template-app-lit/**",
        "packages/create-rstack/template-app-preact-ts/rstack.config.ts",
        "packages/create-rstack/template-app-preact/**",
        "packages/create-rstack/template-app-react-ts/rstack.config.ts",
        "packages/create-rstack/template-app-react/**",
        "packages/create-rstack/template-app-solid-ts/rstack.config.ts",
        "packages/create-rstack/template-app-solid/**",
        "packages/create-rstack/template-app-svelte-ts/rstack.config.ts",
        "packages/create-rstack/template-app-svelte/**",
        "packages/create-rstack/template-app-vanilla-ts/rstack.config.ts",
        "packages/create-rstack/template-app-vanilla/**",
        "packages/create-rstack/template-app-vue-ts/rstack.config.ts",
        "packages/create-rstack/template-app-vue/**",
        "packages/create-rstack/template-lib-node-ts/rstack.config.ts",
        "packages/create-rstack/template-lib-node/**",
        "packages/create-rstack/template-lib-react-ts/rstack.config.ts",
        "packages/create-rstack/template-lib-react/**",
        "packages/create-rstack/template-lib-solid-ts/rstack.config.ts",
        "packages/create-rstack/template-lib-solid/**",
        "packages/create-rstack/template-lib-svelte-ts/rstack.config.ts",
        "packages/create-rstack/template-lib-svelte-ts/scripts/**",
        "packages/create-rstack/template-lib-svelte/**",
        "packages/create-rstack/template-lib-vue-ts/rstack.config.ts",
        "packages/create-rstack/template-lib-vue/**",
        "packages/create-rstack/template-nx/rstack.config.ts",
        "packages/create-rstack/template-nx/packages/ui/rstack.config.ts",
        "packages/create-rstack/template-pnpm/rstack.config.ts",
        "packages/create-rstack/template-pnpm/packages/ui/rstack.config.ts",
        "packages/create-rstack/template-turborepo/**",
        "packages/rstack/binding.cjs",
        "packages/rstack/binding.d.cts",
        "packages/rstack/rslib.config.ts",
        "packages/rstack/rstack.config.ts",
        "packages/rstack/bin/**",
        "packages/rstack/tests/cli/specify-config-lint/workspace/app/src/**",
        "packages/rstack/tests/cli/specify-config/src/**",
        "packages/rstack/tests/config/define-app/src/**",
        "packages/rstack/tests/config/define-lib/src/**",
        "packages/rstack/tests/config/define-lint-base-path/src/**",
        "packages/rstack/tests/config/define-lint/src/**",
        "packages/rstack/tests/config/reload-app-config/src/**",
        "packages/rstack/tests/config/reload-lib-config/src/**",
        "packages/rstack/types/**",
        "scripts/**",
        "website/zephyr.config.js"
      ],
      "rules": {
        "typescript/no-base-to-string": "off",
        "typescript/no-floating-promises": "off",
        "typescript/no-implied-eval": "off",
        "typescript/no-misused-promises": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-unary-minus": "off",
        "typescript/prefer-promise-reject-errors": "off",
        "typescript/require-await": "off",
        "typescript/restrict-plus-operands": "off"
      }
    }
  ]
}
